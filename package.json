{
  "name": "__PACKAGE_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=0.0.0.0 PORT=${DATABRICKS_APP_PORT:-3000} node .next/standalone/server.js",
    "lint": "eslint src scripts tests --ext .ts,.tsx,.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "init-app": "node scripts/init-app.mjs",
    "test:databricks": "tsx scripts/test-databricks.ts",
    "bundle:validate": "databricks bundle validate",
    "bundle:summary": "databricks bundle summary",
    "deploy": "node scripts/deploy.mjs",
    "app:local": "databricks apps run-local --entry-point app.yaml"
  },
  "dependencies": {
    "@databricks/sql": "2.0.0",
    "next": "16.3.1",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.24",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}

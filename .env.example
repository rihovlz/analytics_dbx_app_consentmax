APP_MODE=demo
APP_NAME="analytics-dbx-app-consentmax"
APP_DESCRIPTION="Dashboard ConsentMax — suivi du consentement et contribution Alliance"
APP_SUPPORT_NAME="richard.hooft"
APP_SUPPORT_SLACK_URL="https://valiuz.slack.com/team/richard.hooft"
LOG_LEVEL=info
GENIE_MAX_CONCURRENT_STREAMS=8
GENIE_MAX_CONCURRENT_STREAMS_PER_USER=2

# Required only when APP_MODE=databricks locally.
DATABRICKS_HOST=https://3070470996474403.3.gcp.databricks.com
DATABRICKS_CONFIG_PROFILE=valiuz-analytics-dev
DATABRICKS_SQL_WAREHOUSE_ID=ab362e9710498a08
# Non-secret Genie space ID used by the fraim-sales and sales aliases.
DATABRICKS_GENIE_SPACE_ID_FRAIM_SALES=01f1706a44af166db267134b70dc27c8
# Must match config/data-access.json and config/data-projects.json.
DATABRICKS_CATALOG=dev-consent
DATABRICKS_SCHEMA=analytics
# Legacy fallback only. Leave empty when DATABRICKS_CONFIG_PROFILE is set.
DATABRICKS_TOKEN=

# Query timeout in milliseconds.
DATABRICKS_SQL_TIMEOUT_MS=60000

# Optional personal analyses/preferences. Local demo needs this exact origin.
USER_STATE_ENABLED=false
USER_STATE_ORIGIN=http://127.0.0.1:3100
# Namespace separates environments inside the app identity. Required in Databricks.
USER_STATE_NAMESPACE=dev
